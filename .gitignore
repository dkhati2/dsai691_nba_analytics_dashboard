# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# Environment / secrets
.env
*.pem

# Data (raw + staging are regenerated by the pipeline, not checked in)
data/raw/*
!data/raw/.gitkeep
data/staging/*
!data/staging/.gitkeep

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Dashboard exports that may contain local connection info
dashboard/*.local.*
